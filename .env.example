# ===== 업체 정보 =====
BUSINESS_NAME=OO업체
TIMEZONE=Asia/Seoul
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18
# 월=0 ... 일=6
BUSINESS_DAYS=0,1,2,3,4,5
CONSULT_MINUTES=60

# ===== Claude (https://console.anthropic.com) =====
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1024

# ===== 문자 연결 방식: macrodroid (기본) / smsgate =====
SMS_PROVIDER=macrodroid
# MacroDroid '웹훅(URL)' 트리거 주소 (AI 답장 발송용 매크로)
MACRODROID_SEND_URL=
# 발송 매크로가 이 값과 같은 key 파라미터일 때만 문자를 보내도록 제약조건으로 설정
MACRODROID_SEND_KEY=

# ===== SMS Gateway for Android (SMS_PROVIDER=smsgate 일 때만) =====
# 클라우드 모드: https://api.sms-gate.app/3rdparty/v1
# 로컬 모드:   http://<휴대폰IP>:8080
SMS_GATEWAY_BASE_URL=https://api.sms-gate.app/3rdparty/v1
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_SIGNING_KEY=

# MacroDroid(부재중 전화) / 관리자 API 호출 시 X-Webhook-Token 헤더 값
WEBHOOK_TOKEN=change-me-long-random-string

# ===== Google (서비스 계정) =====
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
GOOGLE_SHEET_ID=
GOOGLE_CALENDAR_ID=

# ===== 사장님 알림 (텔레그램 봇) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== 운영 =====
# true면 구글 시트/캘린더/휴대폰 대신 메모리 가짜를 사용 (Claude 키만 있으면 테스트 가능, 재시작 시 초기화)
MOCK_MODE=false
DATABASE_PATH=data/agent.db
BATCH_WINDOW_SECONDS=45
MAX_REPLIES_PER_HOUR=6
HISTORY_LIMIT=20
REMINDER_HOUR=18
REPORT_HOUR=21
# true면 실제 문자 대신 텔레그램으로 "보낼 내용"만 전달
DRY_RUN=true
# 비어 있지 않으면 이 번호들에게만 응답 (테스트 단계용, 쉼표 구분)
TEST_NUMBERS=
# 통신사 부재중 알림 문자(콜키퍼 등)의 발신번호. 비워두면 문구로 추정, 채우면 이 번호에서 온 문자만 알림으로 인식
MISSED_CALL_NOTICE_SENDERS=
